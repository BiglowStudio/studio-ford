{{ 'sf-base.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Archive: a permanent, editorial index of past collections.
  Each block = one archived collection (year, title, cover image or video, up to 9 gallery images, optional link
  to the old collection page). To archive a new collection later: duplicate a block, swap content. Newest first.
{%- endcomment -%}
<section class="sf-archive">
  <div class="sf-wrap">
    <div class="sf-archive__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="sf-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="sf-heading" style="font-size: clamp(40px, 8vw, 110px);">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<div class="rte" style="margin-top:16px;">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <ul class="sf-archive__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li {{ block.shopify_attributes }}>
          <details class="sf-arch"{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary>
              <span class="sf-arch__year">{{ b.year | escape }}{% if b.season != blank %} · {{ b.season | escape }}{% endif %}</span>
              <span class="sf-arch__title">{{ b.title | escape }}</span>
              <span class="sf-arch__plus" aria-hidden="true">+</span>
            </summary>
            <div class="sf-arch__body">
              {%- if b.video or b.cover -%}
                <div class="sf-arch__cover">
                  {%- if b.video -%}
                    {{ b.video | video_tag: autoplay: false, loop: true, muted: true, playsinline: true, controls: true, image_size: '1400x', poster: b.cover, preload: 'none' }}
                  {%- else -%}
                    {{ b.cover | image_url: width: 1800 | image_tag: widths: '800, 1200, 1800', sizes: '100vw', loading: 'lazy', alt: b.title }}
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- capture gallery -%}
                {%- for i in (1..9) -%}
                  {%- assign key = 'image_' | append: i -%}
                  {%- assign img = b[key] -%}
                  {%- if img -%}
                    <div>{{ img | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 50vw', loading: 'lazy', alt: img.alt | default: b.title }}</div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if gallery contains '<img' -%}<div class="sf-arch__gallery">{{ gallery }}</div>{%- endif -%}
              {%- if b.description != blank -%}<div class="sf-arch__desc rte">{{ b.description }}</div>{%- endif -%}
              {%- if b.link != blank -%}<p><a class="sf-link" href="{{ b.link }}">{{ b.link_label | default: 'View the collection' | escape }}</a></p>{%- endif -%}
            </div>
          </details>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "SF Archive",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Studio Ford" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Archive" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first collection by default", "default": true }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Archived collection",
      "settings": [
        { "type": "text", "id": "year", "label": "Year", "default": "2025" },
        { "type": "text", "id": "season", "label": "Season / drop (optional)" },
        { "type": "text", "id": "title", "label": "Collection name", "default": "Collection name" },
        { "type": "image_picker", "id": "cover", "label": "Cover image (also video poster)" },
        { "type": "video", "id": "video", "label": "Cover video (optional)" },
        { "type": "richtext", "id": "description", "label": "Notes" },
        { "type": "url", "id": "link", "label": "Link to collection (optional)" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "View the collection" },
        { "type": "image_picker", "id": "image_1", "label": "Gallery image 1" },
        { "type": "image_picker", "id": "image_2", "label": "Gallery image 2" },
        { "type": "image_picker", "id": "image_3", "label": "Gallery image 3" },
        { "type": "image_picker", "id": "image_4", "label": "Gallery image 4" },
        { "type": "image_picker", "id": "image_5", "label": "Gallery image 5" },
        { "type": "image_picker", "id": "image_6", "label": "Gallery image 6" },
        { "type": "image_picker", "id": "image_7", "label": "Gallery image 7" },
        { "type": "image_picker", "id": "image_8", "label": "Gallery image 8" },
        { "type": "image_picker", "id": "image_9", "label": "Gallery image 9" }
      ]
    }
  ],
  "presets": [{ "name": "SF Archive", "blocks": [{ "type": "collection" }] }]
}
{% endschema %}
