{{ 'sf-base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sf-quick-add.js' | asset_url }}" defer="defer"></script>
{%- comment -%}
  Shoppable editorial: one big editorial image/video beside 2 hand-picked products. Stack several for rhythm.
{%- endcomment -%}
<section class="sf-section" style="--sf-section-pad: {{ section.settings.padding }}px;">
  <div class="sf-wrap">
    <div class="sf-shop{% if section.settings.flip %} sf-shop--flip{% endif %}">
      <div class="sf-shop__media">
        {%- if section.settings.video -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1100x', poster: section.settings.image }}
        {%- elsif section.settings.image -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: section.settings.heading }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="sf-shop__side">
        <div class="sf-shop__copy">
          {%- if section.settings.eyebrow != blank -%}<p class="sf-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="sf-heading" style="font-size: clamp(26px, 3.4vw, 46px);">{{ section.settings.heading | escape }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<div class="rte" style="margin-top:12px;">{{ section.settings.text }}</div>{%- endif -%}
          {%- if section.settings.link != blank -%}<p style="margin-top:16px;"><a class="sf-link" href="{{ section.settings.link }}">{{ section.settings.link_label | default: 'Shop now' | escape }}</a></p>{%- endif -%}
        </div>
        <div class="sf-shop__products">
          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}
              <div {{ block.shopify_attributes }}>
                {%- render 'sf-product-card', product: block.settings.product, quick_add: section.settings.quick_add, quick_add_style: 'inline', ratio: '4 / 5', sizes: '(min-width: 990px) 22vw, 45vw' -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SF Shoppable Editorial",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Editorial image" },
    { "type": "video", "id": "video", "label": "Video (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false },
    { "type": "checkbox", "id": "quick_add", "label": "Quick Add", "default": true },
    { "type": "range", "id": "padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40, "label": "Vertical padding" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [ { "type": "product", "id": "product", "label": "Product" } ] }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "SF Shoppable Editorial", "blocks": [{ "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
