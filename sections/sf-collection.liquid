{{ 'sf-base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sf-quick-add.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign filtered = false
  for f in collection.filters
    if f.active_values.size > 0
      assign filtered = true
    elsif f.type == 'price_range' and f.min_value.value != nil
      assign filtered = true
    endif
  endfor
  assign show_editorial = true
  if filtered and section.settings.hide_editorial_when_filtered
    assign show_editorial = false
  endif
  assign ratio = section.settings.card_ratio | replace: ':', ' / '
-%}

<div class="sf-wrap sf-collection" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
  <header class="sf-collection__head" style="margin-bottom: 24px;">
    {%- if section.settings.show_title -%}
      <h1 class="sf-heading" style="font-size: clamp(32px, 5vw, 72px);">{{ collection.title | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="rte" style="max-width: 60ch; margin-top: 14px;">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- if section.settings.enable_filters and collection.filters.size > 0 -%}
    {%- comment -%} Toolbar: product-type + print as one-click groups; everything else lives in the same panel. {%- endcomment -%}
    <div class="sf-toolbar" id="sf-toolbar-{{ section.id }}">
      <button type="button" class="sf-btn sf-btn--ghost sf-filter-toggle" data-sf-filter-toggle aria-expanded="false" aria-controls="sf-filters-{{ section.id }}">
        Filter{% if filtered %} (active){% endif %}
      </button>

      <div class="sf-filters-panel" id="sf-filters-{{ section.id }}">
        {%- for filter in collection.filters -%}
          {%- if filter.type == 'price_range' -%}{%- continue -%}{%- endif -%}
          {%- assign is_print = false -%}
          {%- if filter.label == section.settings.print_filter_label -%}{%- assign is_print = true -%}{%- endif -%}
          <fieldset class="sf-filter-group">
            <legend>{{ filter.label | escape }}</legend>
            {%- if is_print and section.settings.print_as_swatches -%}
              <div class="sf-prints">
                {%- for value in filter.values -%}
                  {%- liquid
                    assign href = value.url_to_add
                    if value.active
                      assign href = value.url_to_remove
                    endif
                    assign bg = ''
                    if value.swatch.image
                      assign bg = value.swatch.image | image_url: width: 80 | prepend: 'background-image:url(' | append: ')'
                    elsif value.swatch.color
                      assign bg = value.swatch.color | prepend: 'background-color:'
                    endif
                  -%}
                  <a class="sf-print-label" href="{{ href }}" {% if value.active %}aria-current="true"{% endif %}{% if value.count == 0 and value.active == false %} aria-disabled="true"{% endif %} title="{{ value.label | escape }} ({{ value.count }})">
                    <span class="sf-print" style="{{ bg }}" {% if value.active %}aria-current="true"{% endif %}></span>
                    <span>{{ value.label | escape }}</span>
                  </a>
                {%- endfor -%}
              </div>
            {%- else -%}
              <ul class="sf-chips sf-chips--scroll">
                {%- for value in filter.values -%}
                  {%- liquid
                    assign href = value.url_to_add
                    if value.active
                      assign href = value.url_to_remove
                    endif
                  -%}
                  <li>
                    <a class="sf-chip" href="{{ href }}" {% if value.active %}aria-current="true"{% endif %}{% if value.count == 0 and value.active == false %} aria-disabled="true"{% endif %}>
                      {{ value.label | escape }} <span class="sf-count">{{ value.count }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </fieldset>
        {%- endfor -%}
      </div>

      <div class="sf-toolbar__right" style="display:flex;align-items:center;gap:16px;margin-left:auto;">
        {%- if filtered -%}<a class="sf-link" href="{{ collection.url }}">Clear all</a>{%- endif -%}
        {%- if section.settings.enable_sorting -%}
          <label class="sf-sort"><span class="sf-visually-hidden">Sort by</span>
            <select data-sf-sort>
              {%- for opt in collection.sort_options -%}
                <option value="{{ opt.value }}"{% if opt.value == collection.sort_by %} selected{% endif %}>{{ opt.name | escape }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if collection.products.size == 0 -%}
      <div class="sf-empty">
        <p>No products match these filters.</p>
        <a class="sf-btn" href="{{ collection.url }}">Clear filters</a>
      </div>
    {%- else -%}
      <ul class="sf-grid" role="list">
        {%- for product in collection.products -%}
          {%- if show_editorial -%}
            {%- comment -%} Editorial tiles are slotted in *before* the product at the position they ask for. {%- endcomment -%}
            {%- assign slot = forloop.index0 | plus: 1 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'editorial' and block.settings.before_product == slot and paginate.current_page == block.settings.on_page -%}
                {%- render 'sf-editorial-tile', block: block -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          <li>
            {%- assign lazy_img = true -%}
            {%- if forloop.index <= 6 -%}{%- assign lazy_img = false -%}{%- endif -%}
            {%- render 'sf-product-card',
              product: product,
              ratio: ratio,
              quick_add: section.settings.quick_add,
              quick_add_style: section.settings.quick_add_style,
              hover_image: section.settings.hover_image,
              lazy: lazy_img
            -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="sf-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}<span class="is-current" aria-current="page">{{ part.title }}</span>
            {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">→</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "SF Collection",
  "tag": "section",
  "class": "sf-section-collection",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_title", "label": "Show collection title", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "header", "content": "Product grid" },
    { "type": "range", "id": "products_per_page", "min": 12, "max": 48, "step": 6, "default": 24, "label": "Products per page", "info": "Multiples of 6 keep the 3-col and 2-col grids even." },
    { "type": "select", "id": "card_ratio", "label": "Image ratio", "default": "4:5", "options": [
      { "value": "1:1", "label": "Square" }, { "value": "4:5", "label": "Portrait (4:5)" }, { "value": "3:4", "label": "Portrait (3:4)" }, { "value": "2:3", "label": "Tall (2:3)" } ] },
    { "type": "checkbox", "id": "hover_image", "label": "Swap to alternate image on hover", "default": true, "info": "Uses product metafield custom.hover_image, else the 2nd product image." },
    { "type": "checkbox", "id": "quick_add", "label": "Enable Quick Add", "default": true },
    { "type": "select", "id": "quick_add_style", "label": "Quick Add style", "default": "overlay", "options": [
      { "value": "overlay", "label": "Overlay on hover (desktop), inline on touch" }, { "value": "inline", "label": "Always visible under the product" } ] },
    { "type": "header", "content": "Filtering" },
    { "type": "checkbox", "id": "enable_filters", "label": "Show filters", "default": true, "info": "Configure which filters exist in the Shopify Search & Discovery app." },
    { "type": "checkbox", "id": "enable_sorting", "label": "Show sorting", "default": true },
    { "type": "text", "id": "print_filter_label", "label": "Filter label to show as print swatches", "default": "Print", "info": "Must match the filter's label in Search & Discovery exactly." },
    { "type": "checkbox", "id": "print_as_swatches", "label": "Show print filter as visual swatches", "default": true },
    { "type": "header", "content": "Editorial" },
    { "type": "checkbox", "id": "hide_editorial_when_filtered", "label": "Hide editorial tiles while filtering", "default": true },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36, "label": "Bottom padding" }
  ],
  "blocks": [
    {
      "type": "editorial",
      "name": "Editorial tile",
      "settings": [
        { "type": "select", "id": "size", "label": "Size (columns × rows)", "default": "1x1", "options": [
          { "value": "1x1", "label": "1×1 — single tile" }, { "value": "1x2", "label": "1×2 — one column, two rows tall" }, { "value": "2x1", "label": "2×1 — two columns wide" } ] },
        { "type": "number", "id": "before_product", "label": "Place before product number", "default": 4, "info": "Counted on the page, starting at 1. Use multiples of 3 on desktop to keep rows tidy." },
        { "type": "number", "id": "on_page", "label": "On pagination page", "default": 1 },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video (optional)", "info": "Autoplays muted and loops. The image is used as the poster." },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
