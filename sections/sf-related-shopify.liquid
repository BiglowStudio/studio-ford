{{ 'sf-base.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  "You may also like" — Shopify Recommendations (secondary / fallback).
  Loaded lazily through Shopify's Product Recommendations endpoint; the section hides itself if there are none.
  Tip: set Intent to "Complementary" if you've configured complementary products in the Search & Discovery app.
{%- endcomment -%}
<section class="sf-related" id="sf-recs-{{ section.id }}" data-sf-recs data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}" hidden>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="sf-wrap">
      <div class="sf-section__head"><h2 class="sf-heading" style="font-size: clamp(22px, 3vw, 34px);">{{ section.settings.heading | escape }}</h2></div>
      <div class="sf-related__grid">
        {%- for item in recommendations.products -%}
          {%- render 'sf-product-card', product: item, quick_add: section.settings.quick_add, quick_add_style: 'inline', sizes: '(min-width: 990px) 25vw, 50vw' -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>
<script>
  (function () {
    var el = document.getElementById('sf-recs-{{ section.id }}');
    if (!el || el.dataset.loaded) return;
    function load() {
      el.dataset.loaded = '1';
      fetch(el.dataset.url).then(function (r) { return r.text(); }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.querySelector('#sf-recs-{{ section.id }}');
        if (fresh && fresh.querySelector('.sf-card')) { el.innerHTML = fresh.innerHTML; el.hidden = false; }
      }).catch(function () {});
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (e, o) { if (e[0].isIntersecting) { o.disconnect(); load(); } }, { rootMargin: '400px' }).observe(el);
    } else { load(); }
  })();
</script>
<script src="{{ 'sf-quick-add.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "SF Recommendations",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "min": 2, "max": 10, "step": 2, "default": 4, "label": "Number of products" },
    { "type": "select", "id": "intent", "label": "Intent", "default": "related", "options": [
      { "value": "related", "label": "Related" }, { "value": "complementary", "label": "Complementary" } ] },
    { "type": "checkbox", "id": "quick_add", "label": "Quick Add", "default": false }
  ],
  "presets": [{ "name": "SF Recommendations" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
